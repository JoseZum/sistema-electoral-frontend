{
  "name": "sistema-electoral-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint src tests/integration/browser tests/security next.config.ts playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit --project tsconfig.ci.json",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:ci": "vitest run tests/unit",
    "test:unit:coverage": "vitest --coverage",
    "test:integration": "playwright test -c playwright.config.ts",
    "test:integration:regression": "playwright test -c playwright.config.ts --grep-invert \"@smoke\"",
    "test:integration:smoke": "playwright test -c playwright.config.ts --grep \"@smoke\"",
    "test:e2e:smoke": "npm run test:integration:smoke",
    "test:e2e:full": "npm run test:integration",
    "test:security": "npm run test:security:vulnerabilities",
    "test:security:vulnerabilities": "node tests/security/vulnerabilityAudit.mjs",
    "test:lighthouse": "npm run test:lighthouse:full",
    "test:lighthouse:smoke": "npm run test:lighthouse:auth && npm run test:lighthouse:dashboard && npm run test:lighthouse:voting && npm run test:lighthouse:results && npm run test:lighthouse:scrutiny",
    "test:lighthouse:full": "npm run test:lighthouse:auth && npm run test:lighthouse:tags && npm run test:lighthouse:voting && npm run test:lighthouse:padron && npm run test:lighthouse:audit && npm run test:lighthouse:admin && npm run test:lighthouse:scrutiny && npm run test:lighthouse:results && npm run test:lighthouse:dashboard && npm run test:lighthouse:elections && npm run test:lighthouse:monitoring",
    "test:lighthouse:auth": "node tests/lighthouse/auth/login-page.test.mjs",
    "test:lighthouse:tags": "node tests/lighthouse/tags/tags-page.test.mjs",
    "test:lighthouse:voting": "node tests/lighthouse/voting/voting-pages.test.mjs",
    "test:lighthouse:padron": "node tests/lighthouse/padron/padron-pages.test.mjs",
    "test:lighthouse:audit": "node tests/lighthouse/audit/audit-page.test.mjs",
    "test:lighthouse:admin": "node tests/lighthouse/admin/admin-pages.test.mjs",
    "test:lighthouse:scrutiny": "node tests/lighthouse/scrutiny/scrutiny-pages.test.mjs",
    "test:lighthouse:results": "node tests/lighthouse/results/results-page.test.mjs",
    "test:lighthouse:dashboard": "node tests/lighthouse/dashboard/dashboard-page.test.mjs",
    "test:lighthouse:elections": "node tests/lighthouse/elections/elections-pages.test.mjs",
    "test:lighthouse:monitoring": "node tests/lighthouse/monitoring/monitoring-page.test.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.4.0",
    "@azure/msal-react": "^5.0.6",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "^16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.2"
    },
    "postcss": "8.5.14",
    "sharp": "$sharp",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "1.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^23.0.1",
    "lighthouse": "13.2.0",
    "postcss": "8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^1.0.4"
  }
}
